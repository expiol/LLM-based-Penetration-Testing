# 环境配置文件示例
# 复制此文件为 .env 并修改相应的配置值

# 应用环境
APP_ENV=development
SERVICE_NAME=llm-pen-test
SERVICE_UUID=
APP_VERSION=v0.1.0

# 服务配置
SERVICE_ADDRESS=127.0.0.1
MAX_THREAD=4

# 日志配置
LOGGING_PATH=./logs
LOGGING_NAME=LLM-PENTEST
LOGGING_MAXBYTES=20971520
LOGGING_BACKUP_COUNT=10
LOGGING_DAYS_TO_KEEP=30
LOGGER_LEVEL=INFO

# 模型服务配置
MODEL_SERVE_PROTOCOL=http
MODEL_SERVE_IP=127.0.0.1
MODEL_SERVE_PORT=8000
MODEL_API_KEY=

# LLM端点配置
LORA_GENERATE_URI=/v1/chat/lora
CHAT_COMPLETIONS_URL=/v1/chat/completions

# 文件存储路径
EVENT_FILE_PATH=./pentest_events/files
EVENT_SQL_PATH=./pentest_events/db

# 安全配置
SAFE_MODE=true
ACTIVE_EXPLORATION=false
AUTOMATED_PAYLOAD_GENERATION=true
VULN_EXPLOIT_SIMULATION=false
TRUST_REMOTE_SCANNER_RESULTS=true
NOISE_REDUCTION=true

# 推理配置
REASONING_INTERPRETATION=true
REASONING_INTERPRETATION_MODEL=HengNao-r1

# 热更新配置
HOT_SWAP_CONFIG_FILE=./configs/hot_swaps.yaml
HOT_SWAP_POLL_INTERVAL=10

# 数据库配置（可选）
DATABASE_URL=postgresql://pentest:pentest123@localhost:5432/pentest

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/0
